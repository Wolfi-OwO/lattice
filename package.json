{
  "name": "create-lattice",
  "version": "1.0.0",
  "description": "Pick a stack, pick a database, get a project that already runs. Scaffolds backend, frontend, fullstack, desktop GUI, mobile, CLI and ML projects across JavaScript, TypeScript, Java, Python, C#, Rust, Kotlin, Swift and Dart — installed, wired up and booting.",
  "type": "module",
  "bin": {
    "create-lattice": "bin/lattice.js",
    "lattice": "bin/lattice.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "stacks",
    "overlays",
    "CHANGELOG.md",
    "CONVENTIONS.md",
    "STRUCTURE.md"
  ],
  "scripts": {
    "start": "node bin/lattice.js",
    "list": "node bin/lattice.js --list",
    "test": "node --test tests/cli.test.js tests/scaffold.test.js tests/storage.test.js tests/registry.test.js tests/changelog.test.js tests/doctor.test.js tests/enterprise.test.js tests/generators.test.js",
    "doctor": "node bin/lattice.js doctor"
  },
