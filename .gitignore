# Lattice is dependency-free; node_modules only appears in scaffolded output.
node_modules/
npm-debug.log*

# Scratch output from running the scaffolder locally
/tmp-*/
/demo/
/frames/

# Build output from *running* a template in place while working on it. A template
# ships source and nothing else — a test in tests/registry.test.js fails the build
# if any of this is ever committed, and these lines are what stop it getting that
# far. Scoped to stacks/ so a legitimately-named source directory elsewhere is
# not swallowed by the same pattern.
stacks/**/target/
stacks/**/build/
stacks/**/dist/
stacks/**/.gradle/
stacks/**/__pycache__/
stacks/**/.venv/

# Env files never belong in the repo. The templates ship `_env.example`,
# which the scaffolder renames — that one is meant to be committed.
.env
.env.*
!_env.example

# The documentation site's build output.
#
# documentation/project/ is not hand-written: scripts/docs-mirror.js copies the
# root markdown files into it before every build, so a change made there survives
# until the next one. The real files are ARCHITECTURE.md, CONVENTIONS.md and the
# rest, at the root, where they are read far more often than they would be on a
# website.
/site/
/documentation/project/
.cache/
# MkDocs imports scripts/mkdocs_hooks.py, and Python caches what it imports.
/scripts/__pycache__/

.DS_Store
