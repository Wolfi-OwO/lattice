{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test mocha --exit 'tests/**/*.test.js'",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "eslint src tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.8.0",
    "mocha": "^10.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
